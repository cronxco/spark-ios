 "notes": {
  "t0": {
   "x": 0,
   "y": -250,
   "text": "Onboarding and sign-in",
   "kind": "title1",
   "maxW": 4150
  },
  "s0": {
   "x": 0,
   "y": -154,
   "text": "The first-run flow. Every step is SparkOnboardingScaffold: one glyph, a Comfortaa hero, the reason, and a pinned action stack with a skip.",
   "w": 1180,
   "size": "l",
   "color": "gray"
  },
  "t1": {
   "x": 0,
   "y": 964,
   "text": "The Day tab",
   "kind": "title1",
   "maxW": 2740
  },
  "s1": {
   "x": 0,
   "y": 1060,
   "text": "The main surface. A paged window of days, each one hero, a stat strip, the anomaly pill, check-ins, and an hour-ruled timeline whose rows change weight with what the event is.",
   "w": 1180,
   "size": "l",
   "color": "gray"
  },
  "t2": {
   "x": 0,
   "y": 2178,
   "text": "Up to Speed",
   "kind": "title1",
   "maxW": 6970
  },
  "s2": {
   "x": 0,
   "y": 2274,
   "text": "The full-screen catch-up. Chaptered progress, one card per swipe, a dwell before anything counts as read, and a recap that can put a card back.",
   "w": 1180,
   "size": "l",
   "color": "gray"
  },
  "t3": {
   "x": 0,
   "y": 3392,
   "text": "Explore",
   "kind": "title1",
   "maxW": 4620
  },
  "s3": {
   "x": 0,
   "y": 3488,
   "text": "Five sections behind one tab-bar accessory: Health, Money, Metrics, Map and Tags, plus the money account screens.",
   "w": 1180,
   "size": "l",
   "color": "gray"
  },
  "t4": {
   "x": 0,
   "y": 4606,
   "text": "Knowledge, Flint and Search",
   "kind": "title1",
   "maxW": 4150
  },
  "s4": {
   "x": 0,
   "y": 4702,
   "text": "Reading, Flint's digests and questions, and the prefix-driven search.",
   "w": 1180,
   "size": "l",
   "color": "gray"
  },
  "t5": {
   "x": 0,
   "y": 5820,
   "text": "Detail screens",
